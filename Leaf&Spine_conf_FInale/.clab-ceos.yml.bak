name: ceos-dc-min

mgmt:
  network: mgmt-net
  ipv4-subnet: 172.20.20.0/24


topology:
  defaults:
    kind: ceos
    image: ceos:latest

  nodes:
    spine1:
      startup-config: configs/spine1/startup-config.cfg
      mgmt-ipv4: 172.20.20.2
    spine2:
      startup-config: configs/spine2/startup-config.cfg
      mgmt-ipv4: 172.20.20.6
    leaf1:
      startup-config: configs/leaf1/startup-config.cfg
      mgmt-ipv4: 172.20.20.8
    leaf2:
      startup-config: configs/leaf2/startup-config.cfg
      mgmt-ipv4: 172.20.20.10
    leaf3:
      startup-config: configs/leaf3/startup-config.cfg
      mgmt-ipv4: 172.20.20.4

    yokoso-web:
      kind: linux
      mgmt-ipv4: 172.20.20.3
      image: ghcr.io/dapra-enzo/nginx:latest
      binds:
        - ./index.html:/usr/share/nginx/html/index.html
      exec:
        - apt update
        - apt install -y iproute2 iputils-ping
        - ip addr add 192.168.78.2/30 dev eth1
        - ip link set eth1 up
        - ip route del default via 172.20.20.1 dev eth0
        - ip route add default via 192.168.78.1 dev eth1

    yokoso-web2:
      kind: linux
      mgmt-ipv4: 172.20.20.5
      image: httpd:latest
      binds:
        - ./index.html:/usr/local/apache2/htdocs/index.html
      exec:
        - apt update
        - apt install -y iproute2 iputils-ping
        - ip addr add 192.168.43.2/30 dev eth1
        - ip link set eth1 up
        - ip route del default
        - ip route add default via 192.168.43.1 dev eth1
    
    yokoso-web3:
      kind: linux
      mgmt-ipv4: 172.20.20.56
      image: httpd:latest
      binds:
        - ./index.html:/usr/local/apache2/htdocs/index.html
      exec:
        - apt update
        - apt install -y iproute2 iputils-ping
        - ip addr add 192.168.69.2/30 dev eth1
        - ip link set eth1 up
        - ip route del default
        - ip route add default via 192.168.69.1 dev eth1
        
    yokoso-dns:
      kind: linux
      mgmt-ipv4: 172.20.20.9
      image: ghcr.io/dapra-enzo/unbound-custom:latest
      binds:
        - ./configs/unbound.conf:/etc/unbound/unbound.conf
      exec:
        - apk update
        - apk add iproute2 bind-tools busybox-extras
        - ip link set eth1 up
        - ip addr add 192.168.95.2/24 dev eth1
        - ip route del default via 172.20.20.1 dev eth0
        - ip route add default via 192.168.95.1 dev eth1
        - ip route add 192.168.94.0/24 via 192.168.95.1 dev eth1
        - sh -c 'echo "192.168.94.2 yokoso.com" >> /etc/hosts'
    
    yokoso-haproxy:
      kind: linux
      mgmt-ipv4: 172.20.20.7
      image: haproxy:latest
      binds:
        - ./configs/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg
      exec:
        - apt update
        - apt install -y iproute2 iputils-ping
        - ip addr add 192.168.73.2/30 dev eth1
        - ip link set eth1 up
        - ip route del default
        - ip route add default via 192.168.73.1 dev eth1

    yokoso-ldap:
      kind: linux
      image: ghcr.io/dapra-enzo/saeldap:latest
      exec:
        - apt update
        - apt install -y iproute2 iputils-ping
        - ip link set eth1 up
        - ip addr add 192.168.99.2/24 dev eth1
        - ip route del default
        - ip route add default via 192.168.99.1 dev eth1


  links:
    - endpoints: ["spine1:eth1", "leaf1:eth1"]
    - endpoints: ["spine2:eth1", "leaf1:eth2"]

    - endpoints: ["spine1:eth2", "leaf2:eth1"]
    - endpoints: ["spine2:eth2", "leaf2:eth2"]

    - endpoints: ["spine1:eth3", "leaf3:eth1"]
    - endpoints: ["spine2:eth3", "leaf3:eth2"]

    - endpoints: ["spine1:eth4", "macvlan:enx00e04cdb1ad5"]
    - endpoints: ["spine2:eth4", "macvlan:enx00e04cdb1aed"]

    - endpoints: ["leaf1:eth3", "yokoso-web:eth1"]
    - endpoints: ["leaf1:eth4", "yokoso-dns:eth1"]

    - endpoints: ["leaf1:eth5", "yokoso-web2:eth1"]
    - endpoints: ["leaf2:eth3", "yokoso-haproxy:eth1"]

    - endpoints: ["leaf3:eth3", "yokoso-ldap:eth1"]
